<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Nothing has been published yet (0 tags, 0 releases, 0 packages), so this number is a label, not a
         contract: it moves when a release is cut, never per change. See AGENTS.md § Versioning. The perf
         baseline keys on the tree hash of src/, so editing this file does not invalidate a stored baseline. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <Authors>Wall</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image processing simd aot raster resize filter</PackageTags>
    <DebugType>embedded</DebugType>
    <!-- The commit SHA otherwise lands in AssemblyInformationalVersion, which makes the DLL's bytes a
         function of HEAD rather than of the source: a docs-only commit would silently invalidate the
         performance baseline's binary fingerprint. The baseline records gitSha itself. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Ships IntelliSense; CS1591/CS1573 silenced so the build stays at zero warnings while the
       surface is still moving (M0). Broken crefs/paramrefs still warn. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) and !$(MSBuildProjectName.EndsWith('.AotSmoke'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- AOT/trim analyzers on from the first commit: reflection, P/Invoke and dynamic code
         are build-time errors for the shipped packages, not a later audit. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
