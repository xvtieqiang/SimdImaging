<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Codec layer. Both packages ship in lockstep; keep them on the same version. -->
    <PackageVersion Include="Sdcb.SimdCodecs" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdCodecs.Abstractions" Version="2.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Black-box oracle only, pinned for the comparison report. Never a dependency of a shipped package. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

</Project>
