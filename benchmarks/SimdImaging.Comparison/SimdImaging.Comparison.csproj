<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SimdImaging.Comparison</RootNamespace>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Tool, not a shipped package: the feature-surface probe reflects over the oracle's public
         metadata, which is the opposite of what the AOT/trim analyzers want. The library packages
         keep IsAotCompatible=true from Directory.Build.props. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <!-- Only the path is referenced. The key file is git-ignored and its contents never enter a
         project file, a report or a log (AGENTS.md clean-room rules). -->
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)..\..\docs\sixlabors.lic</SixLaborsLicenseFile>
    <!-- Advisory warnings concern hostile input; this tool only ever decodes its own generated
         in-memory fixtures and is never shipped. -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimdImaging\SimdImaging.csproj" />
    <ProjectReference Include="..\..\src\SimdImaging.Processing\SimdImaging.Processing.csproj" />
    <ProjectReference Include="..\..\src\SimdImaging.Abstractions\SimdImaging.Abstractions.csproj" />
  </ItemGroup>

</Project>
