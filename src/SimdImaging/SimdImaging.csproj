<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SimdImaging</RootNamespace>
    <PackageId>SimdImaging</PackageId>
    <Description>Managed .NET image processing layer over Sdcb.SimdCodecs: load, save and the operator pipeline. Pure managed, NativeAOT-first, three working formats (Rgba8 / Rgba16 / Rgba32F).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimdImaging.Abstractions\SimdImaging.Abstractions.csproj" />
    <ProjectReference Include="..\SimdImaging.Processing\SimdImaging.Processing.csproj" />
    <!-- Codec layer. Pinned to 2.0.x; the version lives in Directory.Packages.props. -->
    <PackageReference Include="Sdcb.SimdCodecs" />
  </ItemGroup>

</Project>
