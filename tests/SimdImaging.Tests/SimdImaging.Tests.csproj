<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SimdImaging.Tests</RootNamespace>
    <!-- xUnit1051: tests are in-memory and finish in milliseconds, so threading
         TestContext.Current.CancellationToken through every call adds noise without buying
         responsiveness. Cancellation itself is covered by dedicated tests once operations run long. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimdImaging\SimdImaging.csproj" />
    <ProjectReference Include="..\..\src\SimdImaging.Abstractions\SimdImaging.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source-shared pixel diff: one definition of the metric, linked by both the test suite
         and the comparison tool. Never introduce a second implementation of the same ruler. -->
    <Compile Include="..\..\src\Shared\PixelDiff.cs" Link="Fixtures\PixelDiff.cs" />
    <Compile Include="..\..\tests\Fixtures\SyntheticCorpus.cs" Link="Fixtures\SyntheticCorpus.cs" />
    <Compile Include="..\..\tests\Fixtures\SyntheticIccProfiles.cs" Link="Fixtures\SyntheticIccProfiles.cs" />
    <Compile Include="..\..\tests\Fixtures\TiffFixture.cs" Link="Fixtures\TiffFixture.cs" />
  </ItemGroup>

</Project>
